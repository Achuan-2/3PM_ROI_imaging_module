function tiff_save(filepath,imgStack)
    %提取不带文件类型后缀的文件名    
    [path, fileName, ext] = fileparts(filename);
    imwrite(uint16(imgStack(:,:,1)),fileName);
    for ii = 2 : size(imgStack, 3)
        imwrite(uint16(imgStack(:,:,ii)) ,fileName,'WriteMode', 'append') ;
    end



    % 保存平均图
    fileName = 'test_avg.tif';
    img_avg = mean(imgStack,3);
    imwrite(uint16(img_avg),fileName);
end